{
  "description": "Repository hard-safety policy. Semantic rules remain in AGENTS.md and .agents/skills/.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/scripts/agent_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking repository safety policy"
          }
        ]
      }
    ]
  }
}
